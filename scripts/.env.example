# Optional. sync.sh/restore.sh already auto-detect common paths and accept
# the path as a plain argument (./scripts/sync.sh /path/to/config), so you
# only need this file if you want to avoid retyping the path every time.
#
# Copy this file to scripts/.env (gitignored) and set RPCS3_CONFIG_DIR.
# Examples:
#
# EmuDeck on Windows (via WSL, /mnt/<drive> style path):
# RPCS3_CONFIG_DIR="/mnt/c/Users/<you>/AppData/Roaming/EmuDeck/Emulators/RPCS3/config"
#
# Standalone RPCS3 on Windows (native, not WSL):
# RPCS3_CONFIG_DIR="C:/Users/<you>/AppData/Roaming/rpcs3/config"
#
# Standalone RPCS3 on Linux/SteamOS (also covers EmuDeck on Linux/SteamOS,
# which does not relocate RPCS3's own config folder):
# RPCS3_CONFIG_DIR="$HOME/.config/rpcs3"
#
# Native Windows PowerShell (sync.ps1/restore.ps1) reads $env:RPCS3_CONFIG_DIR
# instead of this file — set it with:
#   $env:RPCS3_CONFIG_DIR = "C:\path\to\rpcs3\config"

RPCS3_CONFIG_DIR=""
